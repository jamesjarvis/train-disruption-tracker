[Unit]
Description=Train disruption tracker: refresh the feed and publish it to GitHub Pages
Documentation=https://github.com/jamesjarvis/train-disruption-tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/srv/disruption/repo
ExecStart=/srv/disruption/repo/run.sh
TimeoutStartSec=900

Environment=HOME=/srv/disruption
Environment="GIT_SSH_COMMAND=ssh -i /srv/disruption/ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/srv/disruption/ssh/known_hosts"
EnvironmentFile=/etc/train-disruption.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/disruption
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
